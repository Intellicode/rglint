{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemastore.org/sarif-2.1.0.json",
  "title": "SARIF 2.1.0 subset emitted by rglint",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "additionalProperties": false,
      "properties": {
        "tool": { "$ref": "#/$defs/tool" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["driver"],
      "additionalProperties": false,
      "properties": {
        "driver": { "$ref": "#/$defs/driver" }
      }
    },
    "driver": {
      "type": "object",
      "required": ["name", "version", "rules"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "rglint" },
        "version": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "helpUri"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "helpUri": { "type": "string", "format": "uri" }
      }
    },
    "result": {
      "type": "object",
      "required": ["ruleId", "level", "message", "locations"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "level": { "enum": ["error", "warning"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["physicalLocation"],
      "additionalProperties": false,
      "properties": {
        "physicalLocation": { "$ref": "#/$defs/physicalLocation" }
      }
    },
    "physicalLocation": {
      "type": "object",
      "required": ["artifactLocation", "region"],
      "additionalProperties": false,
      "properties": {
        "artifactLocation": { "$ref": "#/$defs/artifactLocation" },
        "region": { "$ref": "#/$defs/region" }
      }
    },
    "artifactLocation": {
      "type": "object",
      "required": ["uri"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 }
      }
    },
    "region": {
      "type": "object",
      "required": ["startLine", "startColumn"],
      "additionalProperties": false,
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
