{
  "name": "@rglint/napi",
  "version": "0.1.0",
  "description": "Node.js bindings for rglint",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": "https://github.com/Intellicode/rglint",
  "napi": {
    "binaryName": "rglint-napi",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": ["index.js", "index.d.ts", "README.md"],
  "optionalDependencies": {
    "@rglint/napi-darwin-arm64": "0.1.0",
    "@rglint/napi-linux-x64-gnu": "0.1.0",
    "@rglint/napi-win32-x64-msvc": "0.1.0"
  }
}
